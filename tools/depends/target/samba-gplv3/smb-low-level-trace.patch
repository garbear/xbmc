+	struct sockaddr_storage local_ss = {0};
+	struct sockaddr_storage remote_ss = {0};
+	socklen_t local_len = sizeof(local_ss);
+	socklen_t remote_len = sizeof(remote_ss);
+	char local_addr[INET6_ADDRSTRLEN] = "unknown";
+	char remote_addr[INET6_ADDRSTRLEN] = "unknown";
+	uint16_t local_port = 0;
+	uint16_t remote_port = 0;
+
+	if (fd >= 0 && getsockname(fd, (struct sockaddr *)&local_ss,
+				    &local_len) == 0) {
+		print_sockaddr(local_addr, sizeof(local_addr), &local_ss);
+		local_port = get_sockaddr_port(&local_ss);
+	}
+	if (fd >= 0 && getpeername(fd, (struct sockaddr *)&remote_ss,
+				    &remote_len) == 0) {
+		print_sockaddr(remote_addr, sizeof(remote_addr), &remote_ss);
+		remote_port = get_sockaddr_port(&remote_ss);
+	}
+
+	DEBUG(0, ("SMBLOWTRACE samba event=%s reason=%s mono_us=%"PRIu64
+		  " thread=%"PRIxPTR" socket_fd=%d api_fd=-1 local=%s:%u"
+		  " remote=%s:%u conn=(nil) context=(nil) dialect=unknown"
+		  " request=transport mid=%"PRIu64" ntstatus=unavailable"
+		  " errno=%d tevent_flags=0x%04x poll_revents=0x%04x conn_state=unknown"
+		  " old_state=socket_ready new_state=socket_error source=%s:%u\n",
+		  event, reason, smb_low_trace_mono_us(),
+		  (uintptr_t)pthread_self(), fd, local_addr, local_port,
+		  remote_addr, remote_port, UINT64_MAX, unix_error,
+		  tevent_flags, poll_revents, function, line));
+	errno = saved_errno;
+}
