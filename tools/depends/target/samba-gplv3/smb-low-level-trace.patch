+	case SMB2_OP_WRITE:
+		return "WRITE";
+	case SMB2_OP_CANCEL:
+		return "CANCEL";
+	case SMB2_OP_KEEPALIVE:
+		return "ECHO";
+	default:
+		return "OTHER";
+	}
+}
+
+void smbXcli_conn_low_trace(struct smbXcli_conn *conn,
+			    const void *context,
+			    const char *event,
+			    const char *reason,
+			    const char *request_type,
+			    uint64_t mid,
+			    NTSTATUS status,
+			    int unix_error,
+			    uint16_t tevent_flags,
+			    int api_fd,
+			    const char *old_state,
+			    const char *new_state,
+			    const char *function,
+			    unsigned int line)
+{
+	int saved_errno = errno;
+	struct smbXcli_transport *xtp = conn != NULL ? conn->transport : NULL;
+	char local_addr[INET6_ADDRSTRLEN] = "unknown";
+	char remote_addr[INET6_ADDRSTRLEN] = "unknown";
+	uint16_t local_port = 0;
+	uint16_t remote_port = 0;
+	int socket_fd = xtp != NULL ? xtp->sock_fd : -1;
+	enum protocol_types protocol = conn != NULL ? conn->protocol : PROTOCOL_NONE;
+	const char *connection_state =
+		xtp != NULL && (xtp->sock_fd != -1 || xtp->tstream != NULL)
+			? "socket_attached" : "disconnected";
+
+	if (xtp != NULL) {
+		print_sockaddr(local_addr, sizeof(local_addr), &xtp->laddr.u.ss);
+		print_sockaddr(remote_addr, sizeof(remote_addr), &xtp->raddr.u.ss);
+		samba_sockaddr_get_port(&xtp->laddr, &local_port);
+		samba_sockaddr_get_port(&xtp->raddr, &remote_port);
+	}
+
+	DEBUG(0, ("SMBLOWTRACE samba event=%s reason=%s mono_us=%"PRIu64
+		  " thread=%"PRIxPTR" socket_fd=%d api_fd=%d local=%s:%u"
+		  " remote=%s:%u conn=%p context=%p dialect=%s request=%s"
+		  " mid=%"PRIu64" ntstatus=0x%08"PRIx32" status_name=%s"
+		  " errno=%d tevent_flags=0x%04x conn_state=%s"
+		  " old_state=%s new_state=%s"
+		  " source=%s:%u\n",
+		  event != NULL ? event : "unknown",
+		  reason != NULL ? reason : "unknown",
+		  smb_low_trace_mono_us(), (uintptr_t)pthread_self(),
+		  socket_fd, api_fd, local_addr, local_port, remote_addr,
+		  remote_port, conn, context,
+		  smb_protocol_types_string(protocol),
+		  request_type != NULL ? request_type : "unknown", mid,
+		  NT_STATUS_V(status), nt_errstr(status), unix_error,
+		  tevent_flags, connection_state,
+		  old_state != NULL ? old_state : "unknown",
+		  new_state != NULL ? new_state : "unknown",
+		  function != NULL ? function : "unknown", line));
+	errno = saved_errno;
+}
+
+void smbXcli_req_low_trace(struct tevent_req *req,
+			   const void *context,
+			   const char *event,
+			   const char *reason,
+			   NTSTATUS status,
+			   int unix_error,
+			   uint16_t tevent_flags,
+			   int api_fd,
+			   const char *old_state,
+			   const char *new_state,
+			   const char *function,
+			   unsigned int line)
+{
+	struct smbXcli_req_state *state = NULL;
+	struct smbXcli_conn *conn = NULL;
+	void *req_data = NULL;
+	const char *request_type = "unavailable";
+	uint16_t opcode = 0;
+	uint64_t mid = UINT64_MAX;
+
+	/*
+	 * This logger is called precisely on incomplete and failing paths. Do not
+	 * use tevent_req_data() here: it calls talloc_get_type_abort() and turns a
+	 * diagnostic metadata problem into a process abort.
+	 */
+	if (req == NULL) {
+		request_type = "unavailable_req_null";
+		goto trace;
+	}
+
+	req_data = _tevent_req_data(req);
+	if (req_data == NULL) {
+		request_type = "unavailable_no_state";
+		goto trace;
+	}
+
+	state = talloc_get_type(req_data, struct smbXcli_req_state);
+	if (state == NULL) {
+		request_type = "unavailable_wrong_state";
+		goto trace;
+	}
+
+	if (state->conn == NULL) {
+		request_type = "unavailable_no_conn";
+		goto trace;
+	}
+
+	conn = talloc_get_type(state->conn, struct smbXcli_conn);
+	if (conn == NULL) {
+		request_type = "unavailable_invalid_conn";
+		goto trace;
+	}
+
+	if (state->smb2.low_trace_header_initialized) {
+		opcode = SVAL(state->smb2.hdr, SMB2_HDR_OPCODE);
+		request_type = smb_low_trace_request_name(opcode);
+		if (state->smb2.low_trace_mid_assigned) {
+			/* MID 0 is valid and must be logged as 0. */
+			mid = BVAL(state->smb2.hdr, SMB2_HDR_MESSAGE_ID);
+		}
+	} else if (IVAL(state->smb1.hdr, 0) == SMB_MAGIC) {
+		request_type = "SMB1";
+		if (state->smb1.mid != 0) {
+			mid = state->smb1.mid;
+		}
+	} else {
+		request_type = "unavailable_no_request_header";
+	}
+
+trace:
+	smbXcli_conn_low_trace(conn, context != NULL ? context : req,
+		event, reason, request_type, mid, status, unix_error,
+		tevent_flags, api_fd, old_state, new_state, function, line);
+}
+
+static void smbXcli_conn_disconnect_cause(struct smbXcli_conn *conn,
+					  NTSTATUS status,
+					  const char *reason,
+					  int unix_error,
+					  uint16_t tevent_flags,
+					  const char *function,
+					  unsigned int line)
+{
+	/* Log the immutable cause before disconnect can complete callbacks. */
+	if (conn != NULL && conn->transport != NULL &&
+	    (conn->transport->sock_fd != -1 ||
+	     conn->transport->tstream != NULL)) {
+		smbXcli_conn_low_trace(conn, conn, "connection_disconnect_cause",
+			reason, "none", UINT64_MAX, status, unix_error,
+			tevent_flags, -1, "socket_attached", "disconnecting",
+			function, line);
+	}
+	smbXcli_conn_disconnect(conn, status);
+}
+
+#define SMBLOW_DISCONNECT(conn, status, reason, unix_error, tevent_flags) \
+	smbXcli_conn_disconnect_cause(conn, status, reason, unix_error, \
+				      tevent_flags, __func__, __LINE__)
+#else
+#define SMBLOW_DISCONNECT(conn, status, reason, unix_error, tevent_flags) \
+	smbXcli_conn_disconnect(conn, status)
+#endif
 
