+static int smb_low_getsockopt_int(int fd,
+				  int level,
+				  int option,
+				  int *value,
+				  int *query_errno)
+{
+	socklen_t len = sizeof(*value);
+	int result;
+
+	*value = -1;
+	*query_errno = 0;
+	if (fd < 0) {
+		*query_errno = EBADF;
+		return -1;
+	}
+
+	errno = 0;
+	result = getsockopt(fd, level, option, value, &len);
+	if (result != 0) {
+		*query_errno = errno;
+		*value = -1;
+	}
+	return result;
+}
